# Copy to .env.local for local development. Values come from the Terraform outputs:
#   cd infra && terraform workspace select dev
#   terraform output user_pool_id
#   terraform output user_pool_client_id
#   terraform output cloudfront_domain
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=

# Local dev only: where Vite forwards /api/* (the deployed dev site)
VITE_DEV_PROXY_TARGET=https://<cloudfront_domain>
